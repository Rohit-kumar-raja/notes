<?xml version="1.0"?>
<sdf version="1.9">
  <model name="amr_robot">
    <pose>0 0 0.1 0 0 0</pose>

    <!-- Main Chassis -->
    <link name="body">
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.08</ixx>
          <iyy>0.12</iyy>
          <izz>0.16</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.50 0.32 0.12</size>
          </box>
        </geometry>
      </collision>

      <!-- Lower Chassis Visual (Dark Industrial Grey) -->
      <visual name="chassis_base_visual">
        <geometry>
          <box>
            <size>0.50 0.32 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.17 1</ambient>
          <diffuse>0.15 0.15 0.17 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <!-- Upper Shell Visual (Industrial Safety Yellow) -->
      <visual name="top_shell_visual">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>0.46 0.28 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.70 0.05 1</ambient>
          <diffuse>0.95 0.70 0.05 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

      <!-- Front Direction Indicator Visual -->
      <visual name="front_indicator_visual">
        <pose>0.24 0 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.20 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.8 0.3 1</ambient>
          <diffuse>0.1 0.9 0.3 1</diffuse>
          <emissive>0.05 0.6 0.2 1</emissive>
        </material>
      </visual>

      <!-- Emergency Stop Button Visual -->
      <visual name="estop_visual">
        <pose>-0.18 0.10 0.08 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.025</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.1 0.1 1</ambient>
          <diffuse>0.9 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- LiDAR Mount Tower Visual -->
      <visual name="lidar_mount_visual">
        <pose>0.08 0 0.08 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- LiDAR Puck Visual -->
      <visual name="lidar_puck_visual">
        <pose>0.08 0 0.125 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.25 0.65 1</ambient>
          <diffuse>0.1 0.35 0.85 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>

      <!-- Forward Camera Housing Visual -->
      <visual name="camera_housing_visual">
        <pose>0.245 0 0.04 0 0 0</pose>
        <geometry>
          <box>
            <size>0.03 0.08 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- Forward Camera Lens Visual -->
      <visual name="camera_lens_visual">
        <pose>0.26 0 0.04 0 1.570796 0</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.4 0.8 1</ambient>
          <diffuse>0.0 0.6 0.9 1</diffuse>
        </material>
      </visual>

      <!-- SENSORS -->

      <!-- 2D / 360 LiDAR Sensor -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>0.08 0 0.13 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/scan</topic>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>15.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>

      <!-- Forward RGB Camera Sensor -->
      <sensor name="camera" type="camera">
        <pose>0.26 0 0.04 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/camera/image_raw</topic>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.15</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>30.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <!-- Front Left Wheel -->
    <link name="front_left_wheel">
      <pose relative_to="body">0.15 0.19 -0.02 -1.570796 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Rear Left Wheel -->
    <link name="rear_left_wheel">
      <pose relative_to="body">-0.15 0.19 -0.02 -1.570796 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Front Right Wheel -->
    <link name="front_right_wheel">
      <pose relative_to="body">0.15 -0.19 -0.02 -1.570796 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Rear Right Wheel -->
    <link name="rear_right_wheel">
      <pose relative_to="body">-0.15 -0.19 -0.02 -1.570796 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- JOINTS -->
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>body</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>body</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>body</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>body</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- 4WD Skid-Steer / Differential Drive Plugin -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.38</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>body</child_frame_id>
    </plugin>
  </model>
</sdf>
