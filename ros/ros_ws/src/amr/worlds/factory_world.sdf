<?xml version="1.0"?>
<sdf version="1.9">
  <world name="factory_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Built-in Gazebo GUI Sensor Panels -->
    <gui fullscreen="0">
      <!-- 1. Live Camera Stream Window -->
      <plugin filename="ImageDisplay" name="AMR Front Camera">
        <gz-gui>
          <title>AMR Camera Feed</title>
          <property key="state" type="string">docked</property>
          <property type="double" key="width">340</property>
          <property type="double" key="height">260</property>
        </gz-gui>
        <topic>/camera/image_raw</topic>
      </plugin>

      <!-- 2. LiDAR 3D Ray Visualizer -->
      <plugin filename="VisualizeLidar" name="Visualize Lidar">
        <gz-gui>
          <property key="state" type="string">docked</property>
        </gz-gui>
      </plugin>
    </gui>

    <!-- Factory Ambient Directional Light (Sun/Roof Skylight) -->
    <light type="directional" name="skylight">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Overhead Warehouse Bay Light 1 -->
    <light type="point" name="bay_light_1">
      <pose>-5 0 4.5 0 0 0</pose>
      <diffuse>0.6 0.6 0.65 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.3</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Overhead Warehouse Bay Light 2 -->
    <light type="point" name="bay_light_2">
      <pose>5 0 4.5 0 0 0</pose>
      <diffuse>0.6 0.6 0.65 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.3</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Factory Floor Ground Plane -->
    <model name="factory_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 22</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 22</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.40 0.42 0.45 1</ambient>
            <diffuse>0.40 0.42 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Factory Environment Model (Walls, Racks, Pallets, Obstacles) -->
    <include>
      <uri>model://factory</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- AMR Robot Model (Chassis, Skid-steer 4WD, LiDAR, RGB Camera) -->
    <include>
      <uri>model://amr_robot</uri>
      <name>amr_robot</name>
      <pose>0 0 0.08 0 0 0</pose>
    </include>

  </world>
</sdf>
